<p class="theme-picker">
  theme:
  <a href="#" data-set-theme="black">black</a> |
  <a href="#" data-set-theme="white">white</a> |
  <a href="#" data-set-theme="paper">paper</a> |
  <a href="#" data-set-theme="paper-white">paper-white</a> |
  <a href="#" data-set-theme="gray">gray</a> |
  <a href="#" data-set-theme="terminal">terminal</a>
</p>
<hr />
<script is:inline>
  document.querySelectorAll('[data-set-theme]').forEach(function (a) {
    a.addEventListener('click', function (e) {
      e.preventDefault();
      var t = a.dataset.setTheme;
      document.documentElement.dataset.theme = t;
      try { localStorage.setItem('theme', t); } catch (err) {}
    });
  });
</script>
