---
interface Props {
  href?: string;
  title: string;
  tags: string;
  blurb: string;
  featured?: boolean;
  external?: boolean;
}
const { href, title, tags, blurb, external = false } = Astro.props;
---

<p>
  {href
    ? <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}><b>{title}</b></a>
    : <b>{title}</b>}
  <br />
  <span class="muted">{tags}</span>
  <br />
  {blurb}
</p>
