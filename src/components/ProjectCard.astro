---
interface Props {
  id?: string;
  href?: string;
  title: string;
  tags: string;
  blurb: string;
}
const { id, href, title, tags, blurb } = Astro.props;
---

<div class="card" id={id}>
  <div class="card-title">{href ? <a href={href}>{title}</a> : title}</div>
  <div class="muted">{tags}</div>
  <p>{blurb}</p>
</div>
