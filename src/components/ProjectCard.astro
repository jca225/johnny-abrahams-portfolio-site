---
interface Props {
  href?: string;
  title: string;
  tags: string;
  blurb: string;
  featured?: boolean;
  external?: boolean;
}
const { href, title, tags, blurb, featured = false, external = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={['card', featured && 'card-featured', !href && 'card-static']}
  target={href && external ? '_blank' : undefined}
  rel={href && external ? 'noopener' : undefined}
>
  <div class="card-row">
    <h3 class="card-title">{title}</h3>
    <span class="card-tags">{tags}</span>
  </div>
  <p class="card-blurb">{blurb}</p>
  {href && <span class="card-arrow" aria-hidden="true">→</span>}
</Tag>

<style>
  .card {
    border-bottom: none;
  }
  .card-arrow {
    position: absolute;
    right: 0;
    bottom: 1.6rem;
  }
  .card-featured .card-arrow { bottom: 2.4rem; }
  /* Non-linked info cards: same look, no link affordance. */
  .card-static { cursor: default; }
  @media (max-width: 600px) {
    .card-arrow { display: none; }
  }
</style>
