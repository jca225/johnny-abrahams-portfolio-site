---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { authorshipFor, LABEL } from '../lib/authorship';

interface Props {
  title?: string;
  description?: string;
  current?: 'home' | 'projects' | 'essays' | 'writing';
}

const {
  title = 'John Abrahams',
  description = 'John Abrahams. Master\'s student in Data Science at Penn. Systems and machine learning.',
  current,
} = Astro.props;

const fullTitle = title === 'John Abrahams' ? title : `${title} - John Abrahams`;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const authorship = authorshipFor(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/og.png', Astro.site).toString()} />
  </head>
  <body>
    <div class="page">
      <Nav current={current} />
      <main>
        <slot />
      </main>
      <footer class="foot muted">
        {LABEL[authorship.by]} ·
        <a href="https://github.com/jca225">GitHub</a> ·
        <a href="https://www.linkedin.com/in/john-abrahams-94a04924a">LinkedIn</a> ·
        <a href="mailto:johnnycabrahams@gmail.com">Email</a>
      </footer>
    </div>
  </body>
</html>
