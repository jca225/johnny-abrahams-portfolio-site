---
import Base from './Base.astro';

interface Props {
  title: string;
  subtitle?: string;
  meta?: string;
  links?: { label: string; href: string; external?: boolean }[];
  description?: string;
}
const { title, subtitle, meta, links = [], description } = Astro.props;
---

<Base title={title} description={description ?? subtitle ?? title} current="projects">
  <p><a href="/#projects">Back to all projects</a></p>
  <h1>{title}</h1>
  {meta && <p class="muted">{meta}</p>}
  {subtitle && <p>{subtitle}</p>}
  {links.length > 0 && (
    <p>
      {links.map((l, i) => (
        <>
          {i > 0 && ' | '}
          <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>{l.label}</a>
        </>
      ))}
    </p>
  )}
  <hr />
  <slot />
</Base>
