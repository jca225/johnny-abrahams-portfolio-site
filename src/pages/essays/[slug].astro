---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { publishedEssays, essayDate } from '../../lib/essays';

export async function getStaticPaths() {
  const essays = await publishedEssays();
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay } }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---

<Base title={essay.data.title} description={essay.data.description} current="essays">
  <article class="essay">
    <h1>{essay.data.title}</h1>
    <p class="muted">{essayDate(essay.data.date)}</p>
    <Content />
  </article>
</Base>
