---
// Generated from profile/profile.yaml. Edit the YAML, not this file's content.
import Base from '../layouts/Base.astro';
import { profile } from '../lib/profile';

const { identity, site, publications } = profile;
const selected = site.projects.filter((p: any) => p.featured);
const papers = publications.filter((p: any) => p.home);
---

<Base title={identity.full_name} current="home">
  <h1>{identity.full_name}</h1>
  <p>{site.bio}</p>

  <h2>Selected work</h2>
  <ul class="list">
    {selected.map((p: any) => (
      <li>
        <a href={p.page ?? `/projects#${p.id}`}>{p.title}</a><br />
        <span class="muted">{p.summary}</span>
      </li>
    ))}
  </ul>

  <h2>Papers</h2>
  <ul class="list">
    {papers.map((w: any) => (
      <li>
        {w.pdf ? <a href={w.pdf}>{w.short_title ?? w.title}</a> : (w.short_title ?? w.title)}
        {' '}<span class="muted">({w.year}, {w.with})</span>
      </li>
    ))}
  </ul>
</Base>
