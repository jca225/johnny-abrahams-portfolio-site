---
// Generated from profile/profile.yaml (publications). Edit the YAML.
import Base from '../layouts/Base.astro';
import { profile } from '../lib/profile';
const pubs = profile.publications;
---

<Base title="Writing" description="Papers and writeups by John Abrahams: systems, applied ML, and clinical research." current="writing">
  <h1>Papers and writeups</h1>
  {pubs.map((w: any) => (
    <p>
      <a href={w.pdf} target="_blank" rel="noopener"><b>{w.title}</b></a><br />
      <span class="muted">{w.meta}</span><br />
      {w.abstract}<br />
      {w.page && <><a href={w.page}>Project page</a> | </>}
      <a href={w.pdf} target="_blank" rel="noopener">PDF</a>
      {w.github && <> | <a href={w.github} target="_blank" rel="noopener">GitHub</a></>}
    </p>
  ))}
</Base>
